# Copy this file to ".env" and fill in real values before running the server.

# Any free port on your machine
PORT=4000

# A long random string used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# The public URL of this server once deployed (used for Paystack's redirect after payment).
# For local testing this can stay as-is.
APP_URL=http://localhost:4000

# NOTE: Your actual Paystack public/secret keys are NOT set here.
# Once the server is running, sign up as the first user (this makes you admin),
# then open /admin.html in your browser and paste your Paystack keys there.
